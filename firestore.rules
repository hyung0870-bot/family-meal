rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가족 코드(문서 ID)를 아는 사람만 그 가족의 하위 컬렉션을 읽고 쓴다.
    // families 컬렉션 자체엔 규칙이 없어 가족 목록 조회는 막힌다.
    match /families/{fam}/{coll}/{rest=**} {
      allow read, write: if fam.size() >= 20
        && coll in ['settings', 'plans', 'logs'];
    }
  }
}
